# TeraBox Referral Automator - Configuration Example
# Copy this file to .env and adjust your settings

# Web Dashboard Port (default: 8080)
PORT=8080

# Primary Email Provider (mailtm or 1secmail)
EMAIL_PROVIDER=mailtm

# Browser Mode: true for invisible background, false for visible Chrome GUI
HEADLESS=true

# Delay in seconds between each referral link
DELAY_SECONDS=15

# Delay in seconds between each full round of links
ROUND_DELAY=30

# Require connected Android phone via ADB for dynamic mobile IP rotation
REQUIRE_ADB=true

# Optional: Telegram Bot Remote Control
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Google Gemini API Key for LLM vision fallback element detection
GEMINI_API_KEY=
